{
  "productName": "RAGCreator",
  "version": "0.1.0",
  "identifier": "com.ragcreator.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "RAGCreator",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 640,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "iOS": {
      "minimumSystemVersion": "15.0",
      "bundleVersion": "2"
    }
  }
}
